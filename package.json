{
  "name": "pixel-wars",
  "private": true,
  "version": "1.0.0",
  "description": "PIXEL WARS: Algorithm Battlegrounds - autonomous expansion algorithms fight for territory on a pixel grid.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "balance": "node --experimental-strip-types --no-warnings scripts/balance.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
